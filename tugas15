print("=== KALKULATOR SEDERHANA ===")

angka1 = int(input("masukan angka pertama : "))
angka2 = int(input("masukan angka kedua : "))

print("1. penjumlahan")
print("2. pengurangan")
print("3. perkalian")
print("4. pembagian")

pilihan = input("pilih operasi : ")

if pilihan == "1":
    hasil = angka1 + angka2
    print("hasil =", hasil)

elif pilihan == "2":
    hasil = angka1 - angka2
    print("hasil =", hasil)

elif pilihan == "3":
    hasil = angka1 * angka2
    print("hasil =", hasil)

elif pilihan == "4":
    hasil = angka1 / angka2
    print("hasil =", hasil)

else:
    print("pilihan tidak tersedia")